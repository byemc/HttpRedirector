<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <OutputType>WinExe</OutputType>
	  <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <UseWindowsForms>true</UseWindowsForms>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <TargetPlatformIdentifier>windows</TargetPlatformIdentifier>
      <EnableWindowsTargeting>True</EnableWindowsTargeting>
	  <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	  <StartupObject>HttpRedirector.Program</StartupObject>
	  <Version>1.0.1.1</Version>
	  <Title>HTTP Redirector</Title>
	  <Company>byespace</Company>
	  <Win32Resource>C:\Users\Bye\source\repos\HttpRedirector\HttpRedirector\Resources\resources.res</Win32Resource>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\httpredirector.ico" />
	<Content Include="Resources\html-file.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resource1.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource1.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resource1.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource1.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>